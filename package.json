{
	"name": "doctor-tracker-server",
	"version": "1.0.0",
	"description": "Doctor Tracker — standalone Express + MongoDB REST API",
	"type": "module",
	"engines": {
		"node": ">=20.10.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"dev:memory": "tsx src/db/devMemoryServer.ts",
		"build": "tsc -p tsconfig.json",
		"start": "tsx src/index.ts",
		"seed": "tsx src/db/seed.ts",
		"sync-indexes": "tsx src/db/syncIndexes.ts",
		"reconcile-counts": "tsx src/db/reconcileCounts.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"compression": "^1.7.5",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^5.0.1",
		"express-rate-limit": "^7.5.0",
		"helmet": "^8.0.0",
		"jsonwebtoken": "^9.0.2",
		"lru-cache": "^11.0.2",
		"mongoose": "^8.9.5",
		"pino": "^9.6.0",
		"pino-http": "^10.4.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/compression": "^1.7.5",
		"@types/cookie-parser": "^1.4.8",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^22.10.5",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"mongodb-memory-server": "^10.1.3",
		"pino-pretty": "^13.0.0",
		"prettier": "^3.4.2",
		"supertest": "^7.0.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"vitest": "^2.1.8"
	}
}