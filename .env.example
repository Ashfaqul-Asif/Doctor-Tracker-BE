NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Atlas > Connect > Drivers. Allowlist your IP under Network Access.
# No <angle brackets> around the password; percent-encode @ : / ? # [ ] % if it contains them.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.h6twpkr.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=careguide

# comma-separated allowlist; add the deployed client URL before going live
CLIENT_ORIGINS=http://localhost:3000
# date presets + $dateTrunc bucket boundaries
DEFAULT_TIMEZONE=Asia/Dhaka

JWT_ACCESS_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=generate_a_DIFFERENT_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Bootstrap admin — read once at seed time, stored only as an argon2id hash
SEED_ADMIN_EMAIL=ashfaqulasif41@gmail.com
SEED_ADMIN_NAME=Ashfaqul Asif
SEED_ADMIN_PASSWORD=
# safety latch — must equal MONGODB_DB_NAME for the seed to run
SEED_CONFIRM=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
LOG_LEVEL=debug
